export default function Home() {
  const [item, setItem] = useState('')
  const [price, setPrice] = useState(0)
  const [down, setDown] = useState(0)
  const [months, setMonths] = useState(6)
  const [file, setFile] = useState(null)
  const [refNum, setRefNum] = useState('')
  const [msg, setMsg] = useState('')

  const monthly = price ? ((price - down) / months).toFixed(2) : 0

  async function submitHulugan() {
    const ref = 'HULOG' + Date.now().toString().slice(-6)
    setRefNum(ref)
    
    const { error } = await supabase.from('hulugan').insert({
      item_name: item,
      total_price: price,
      down_payment: down,
      monthly_payment: monthly,
      months: months,
      balance: price - down,
      ref_number: ref,
      status: 'pending_receipt'
    })

    if(!error) setMsg(`Step 1: Save this Ref No: ${ref}\nStep 2: Send ₱${down} to ${CONFIG